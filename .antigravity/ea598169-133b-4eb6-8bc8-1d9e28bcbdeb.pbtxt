    instruction: "Add comments moderation, image uploading, and tags persistence APIs with static folder serving."
    replacement_infos {
      original_chunk {
        target_content: "  // Admin: Get all newsletter signups\n  app.get(\"/api/admin/newsletter\", (req, res) => {\n    res.json(newsletterSignups);\n  });\n\n  // Admin: Create dynamic blog post file\n  app.post(\"/api/admin/posts\", (req, res) => {\n    const { id, title, category, author, excerpt, readTime, content } = req.body;\n    if (!id || !title || !content) {\n      res.status(400).json({ error: \"id, title and content are required\" });\n      return;\n    }\n\n    const postsDir = path.join(process.cwd(), \"posts\");\n    \n    // Safety check for filename traversal\n    if (id.includes(\"/\") || id.includes(\"..\") || id.includes(\"\\\\\")) {\n      res.status(400).json({ error: \"Invalid post ID\" });\n      return;\n    }\n\n    const filePath = path.join(postsDir, `${id}.md`);\n    const date = new Date().toISOString().split(\'T\')[0];\n    const postData = {\n      id,\n      title,\n      date,\n      category: category || \"News\",\n      author: author || \"Staff Reporter\",\n      excerpt: excerpt || (content.length > 150 ? content.slice(0, 150) + \"...\" : content),\n      readTime: readTime || \"3 min read\",\n      content\n    };\n\n    const fileContent = `---\nid: ${postData.id}\ntitle: ${postData.title}\ndate: ${postData.date}\ncategory: ${postData.category}\nauthor: ${postData.author}\nexcerpt: ${postData.excerpt}\nreadTime: ${postData.readTime}\n---\n\n${postData.content}`;\n\n    try {\n      fs.writeFileSync(filePath, fileContent, \"utf-8\");\n      res.status(201).json(postData);\n    } catch (err) {\n      console.error(err);\n      res.status(500).json({ error: \"Failed to write blog post file\" });\n    }\n  });\n\n  // Admin: Edit blog post file\n  app.put(\"/api/admin/posts/:id\", (req, res) => {\n    const { id } = req.params;\n    const { title, category, author, excerpt, readTime, content } = req.body;\n\n    if (!title || !content) {\n      res.status(400).json({ error: \"title and content are required\" });\n      return;\n    }\n\n    const postsDir = path.join(process.cwd(), \"posts\");\n    const filePath = path.join(postsDir, `${id}.md`);\n\n    if (!fs.existsSync(filePath)) {\n      res.status(404).json({ error: \"Post file does not exist\" });\n      return;\n    }\n\n    try {\n      const existingPost = parseMarkdownFile(filePath, `${id}.md`);\n      const postData = {\n        id,\n        title,\n        date: existingPost.date || new Date().toISOString().split(\'T\')[0],\n        category: category || existingPost.category,\n        author: author || existingPost.author,\n        excerpt: excerpt || (content.length > 150 ? content.slice(0, 150) + \"...\" : content),\n        readTime: readTime || existingPost.readTime,\n        content\n      };\n\n      const fileContent = `---\nid: ${postData.id}\ntitle: ${postData.title}\ndate: ${postData.date}\ncategory: ${postData.category}\nauthor: ${postData.author}\nexcerpt: ${postData.excerpt}\nreadTime: ${postData.readTime}\n---\n\n${postData.content}`;\n\n      fs.writeFileSync(filePath, fileContent, \"utf-8\");\n      res.json(postData);\n    } catch (err) {\n      console.error(err);\n      res.status(500).json({ error: \"Failed to edit blog post file\" });\n    }\n  });\n\n  // Admin: Delete blog post file\n  app.delete(\"/api/admin/posts/:id\", (req, res) => {\n    const { id } = req.params;\n    const postsDir = path.join(process.cwd(), \"posts\");\n    const filePath = path.join(postsDir, `${id}.md`);\n\n    if (!fs.existsSync(filePath)) {\n      res.status(404).json({ error: \"Post file does not exist\" });\n      return;\n    }\n\n    try {\n      fs.unlinkSync(filePath);\n      res.json({ success: true, message: \"Post deleted successfully\" });\n    } catch (err) {\n      console.error(err);\n      res.status(500).json({ error: \"Failed to delete blog post file\" });\n    }\n  });"
        replacement_content: "  // Admin: Get all newsletter signups\n  app.get(\"/api/admin/newsletter\", (req, res) => {\n    res.json(newsletterSignups);\n  });\n\n  // Admin: Get all pending & approved comments\n  app.get(\"/api/admin/comments\", (req, res) => {\n    const allComments: any[] = [];\n    Object.entries(commentsStore).forEach(([postId, list]) => {\n      list.forEach((c) => {\n        allComments.push({ ...c, postId });\n      });\n    });\n    // Sort reviews newest first\n    allComments.sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());\n    res.json(allComments);\n  });\n\n  // Admin: Approve a comment\n  app.put(\"/api/admin/comments/:id/approve\", (req, res) => {\n    const { id } = req.params;\n    let found = false;\n    Object.keys(commentsStore).forEach((postId) => {\n      commentsStore[postId] = commentsStore[postId].map((comment) => {\n        if (comment.id === id) {\n          found = true;\n          return { ...comment, approved: true };\n        }\n        return comment;\n      });\n    });\n    if (found) {\n      res.json({ success: true, message: \"Comment approved successfully.\" });\n    } else {\n      res.status(404).json({ error: \"Comment not found\" });\n    }\n  });\n\n  // Admin: Reject / delete a comment\n  app.delete(\"/api/admin/comments/:id\", (req, res) => {\n    const { id } = req.params;\n    let found = false;\n    Object.keys(commentsStore).forEach((postId) => {\n      const initialLength = commentsStore[postId].length;\n      commentsStore[postId] = commentsStore[postId].filter((comment) => comment.id !== id);\n      if (commentsStore[postId].length < initialLength) {\n        found = true;\n      }\n    });\n    if (found) {\n      res.json({ success: true, message: \"Comment rejected and removed.\" });\n    } else {\n      res.status(404).json({ error: \"Comment not found\" });\n    }\n  });\n\n  // Admin: Get moderator log emails\n  app.get(\"/api/admin/emails\", (req, res) => {\n    res.json(moderatorEmails);\n  });\n\n  // Admin: Upload custom visuals (Images)\n  app.post(\"/api/admin/upload-image\", (req, res) => {\n    const { name, data } = req.body;\n    if (!name || !data) {\n      res.status(400).json({ error: \"Name and image data are required\" });\n      return;\n    }\n\n    try {\n      const matches = data.match(/^data:([A-Za-z-+\\/]+);base64,(.+)$/);\n      if (!matches || matches.length !== 3) {\n        res.status(400).json({ error: \"Invalid base64 image data URI format.\" });\n        return;\n      }\n\n      const imageBuffer = Buffer.from(matches[2], \"base64\");\n      const extension = name.split(\".\").pop();\n      const safeName = `${Date.now()}-${Math.random().toString(36).substr(2, 6)}.${extension}`;\n      \n      const uDir = path.join(process.cwd(), \"uploads\");\n      if (!fs.existsSync(uDir)) {\n        fs.mkdirSync(uDir);\n      }\n\n      const filePath = path.join(uDir, safeName);\n      fs.writeFileSync(filePath, imageBuffer);\n\n      res.status(201).json({ url: `/uploads/${safeName}`, name: safeName });\n    } catch (err) {\n      console.error(\"Error writing image upload file:\", err);\n      res.status(500).json({ error: \"Failed to write image to disk\" });\n    }\n  });\n\n  // Admin: Get uploaded images list\n  app.get(\"/api/admin/images\", (req, res) => {\n    try {\n      const uDir = path.join(process.cwd(), \"uploads\");\n      if (!fs.existsSync(uDir)) {\n        res.json([]);\n        return;\n      }\n      const files = fs.readdirSync(uDir);\n      const imagesList = files.map((file) => {\n        const stats = fs.statSync(path.join(uDir, file));\n        return {\n          name: file,\n          url: `/uploads/${file}`,\n          uploadedAt: stats.mtime\n        };\n      }).sort((a, b) => b.uploadedAt.getTime() - a.uploadedAt.getTime());\n      res.json(imagesList);\n    } catch (err) {\n      console.error(\"Error listing images:\", err);\n      res.status(500).json({ error: \"Failed to list media folder\" });\n    }\n  });\n\n  // Admin: Delete uploaded image\n  app.delete(\"/api/admin/images/:name\", (req, res) => {\n    const { name } = req.params;\n    const uDir = path.join(process.cwd(), \"uploads\");\n    const filePath = path.join(uDir, name);\n\n    if (!fs.existsSync(filePath)) {\n      res.status(404).json({ error: \"File not found\" });\n      return;\n    }\n\n    try {\n      fs.unlinkSync(filePath);\n      res.json({ success: true, message: \"File deleted successfully\" });\n    } catch (err) {\n      console.error(err);\n      res.status(500).json({ error: \"Failed to delete file from disk\" });\n    }\n  });\n\n  // Admin: Create dynamic blog post file\n  app.post(\"/api/admin/posts\", (req, res) => {\n    const { id, title, category, tags, author, excerpt, readTime, content } = req.body;\n    if (!id || !title || !content) {\n      res.status(400).json({ error: \"id, title and content are required\" });\n      return;\n    }\n\n    const postsDir = path.join(process.cwd(), \"posts\");\n    \n    // Safety check for filename traversal\n    if (id.includes(\"/\") || id.includes(\"..\") || id.includes(\"\\\\\")) {\n      res.status(400).json({ error: \"Invalid post ID\" });\n      return;\n    }\n\n    const filePath = path.join(postsDir, `${id}.md`);\n    const date = new Date().toISOString().split(\'T\')[0];\n    \n    const finalTags = Array.isArray(tags) ? tags : (tags ? String(tags).split(\',\').map((t)=>t.trim()).filter(Boolean) : []);\n    const postData = {\n      id,\n      title,\n      date,\n      category: category || \"News\",\n      tags: finalTags,\n      author: author || \"Staff Reporter\",\n      excerpt: excerpt || (content.length > 150 ? content.slice(0, 150) + \"...\" : content),\n      readTime: readTime || \"3 min read\",\n      content\n    };\n\n    const fileContent = `---\nid: ${postData.id}\ntitle: ${postData.title}\ndate: ${postData.date}\ncategory: ${postData.category}\ntags: ${postData.tags.join(\", \")}\nauthor: ${postData.author}\nexcerpt: ${postData.excerpt}\nreadTime: ${postData.readTime}\n---\n\n${postData.content}`;\n\n    try {\n      fs.writeFileSync(filePath, fileContent, \"utf-8\");\n      res.status(201).json(postData);\n    } catch (err) {\n      console.error(err);\n      res.status(500).json({ error: \"Failed to write blog post file\" });\n    }\n  });\n\n  // Admin: Edit blog post file\n  app.put(\"/api/admin/posts/:id\", (req, res) => {\n    const { id } = req.params;\n    const { title, category, tags, author, excerpt, readTime, content } = req.body;\n\n    if (!title || !content) {\n      res.status(400).json({ error: \"title and content are required\" });\n      return;\n    }\n\n    const postsDir = path.join(process.cwd(), \"posts\");\n    const filePath = path.join(postsDir, `${id}.md`);\n\n    if (!fs.existsSync(filePath)) {\n      res.status(404).json({ error: \"Post file does not exist\" });\n      return;\n    }\n\n    try {\n      const existingPost = parseMarkdownFile(filePath, `${id}.md`);\n      const finalTags = Array.isArray(tags) ? tags : (tags ? String(tags).split(\',\').map((t)=>t.trim()).filter(Boolean) : []);\n      const postData = {\n        id,\n        title,\n        date: existingPost.date || new Date().toISOString().split(\'T\')[0],\n        category: category || existingPost.category,\n        tags: finalTags,\n        author: author || existingPost.author,\n        excerpt: excerpt || (content.length > 150 ? content.slice(0, 150) + \"...\" : content),\n        readTime: readTime || existingPost.readTime,\n        content\n      };\n\n      const fileContent = `---\nid: ${postData.id}\ntitle: ${postData.title}\ndate: ${postData.date}\ncategory: ${postData.category}\ntags: ${postData.tags.join(\", \")}\nauthor: ${postData.author}\nexcerpt: ${postData.excerpt}\nreadTime: ${postData.readTime}\n---\n\n${postData.content}`;\n\n      fs.writeFileSync(filePath, fileContent, \"utf-8\");\n      res.json(postData);\n    } catch (err) {\n      console.error(err);\n      res.status(500).json({ error: \"Failed to edit blog post file\" });\n    }\n  });\n\n  // Admin: Delete blog post file\n  app.delete(\"/api/admin/posts/:id\", (req, res) => {\n    const { id } = req.params;\n    const postsDir = path.join(process.cwd(), \"posts\");\n    const filePath = path.join(postsDir, `${id}.md`);\n\n    if (!fs.existsSync(filePath)) {\n      res.status(404).json({ error: \"Post file does not exist\" });\n      return;\n    }\n\n    try {\n      fs.unlinkSync(filePath);\n      res.json({ success: true, message: \"Post deleted successfully\" });\n    } catch (err) {\n      console.error(err);\n      res.status(500).json({ error: \"Failed to delete blog post file\" });\n    }\n  });\n\n  // Set up static uploads dir serving immediately before development/production routers\n  const uploadsDir = path.join(process.cwd(), \"uploads\");\n  if (!fs.existsSync(uploadsDir)) {\n    fs.mkdirSync(uploadsDir);\n  }\n  app.use(\"/uploads\", express.static(uploadsDir));"
      }

    instruction: "Introduce beautiful Admin Panel and login flow within App.tsx view mode switcher"
    replacement_infos {
      original_chunk {
        target_content: "          {/* View Mode Switching */}\n          {!selectedPostId ? ("
        replacement_content: "          {/* View Mode Switching */}\n          {currentView === \"admin\" ? (\n            /* System Admin Panel View */\n            <div id=\"admin-panel-container\" className=\"space-y-8 animate-fade-in\">\n              <div className=\"flex items-center justify-between border-b border-stone-200 pb-4\">\n                <h2 className=\"text-xl font-display font-black text-stone-900 tracking-tight uppercase flex items-center gap-2\">\n                  <Lock className=\"text-stone-950\" size={18} />\n                  System Admin Panel\n                </h2>\n                {adminLoggedIn && (\n                  <button\n                    onClick={() => {\n                      setAdminLoggedIn(false);\n                      setAdminUser(\"\");\n                      setAdminPassword(\"\");\n                    }}\n                    className=\"inline-flex items-center gap-1 px-3 py-1 bg-stone-100 hover:bg-stone-200 text-stone-600 hover:text-stone-900 text-xs font-mono rounded cursor-pointer transition-colors\"\n                  >\n                    <LogOut size={12} />\n                    LEAVE PANEL\n                  </button>\n                )}\n              </div>\n\n              {!adminLoggedIn ? (\n                /* Login Section */\n                <div id=\"admin-login-card\" className=\"border border-stone-200 bg-white p-6 rounded-md shadow-sm space-y-4 max-w-sm mx-auto\">\n                  <div className=\"text-center space-y-1\">\n                    <h3 className=\"text-sm font-mono font-bold uppercase tracking-wider text-stone-700\">Login Required</h3>\n                    <p className=\"text-xs text-stone-400\">Please provide the system login credentials to manage publications.</p>\n                  </div>\n\n                  <form onSubmit={handleAdminLogin} className=\"space-y-3 pt-2\">\n                    <div>\n                      <label className=\"block text-[10px] font-mono uppercase text-stone-500 font-bold mb-1\" htmlFor=\"admin-user-input\">Username</label>\n                      <input\n                        id=\"admin-user-input\"\n                        type=\"text\"\n                        required\n                        placeholder=\"e.g. admin\"\n                        value={adminUser}\n                        onChange={(e) => setAdminUser(e.target.value)}\n                        className=\"w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded focus:border-stone-900 focus:outline-none transition-colors\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-[10px] font-mono uppercase text-stone-500 font-bold mb-1\" htmlFor=\"admin-pass-input\">Password</label>\n                      <input\n                        id=\"admin-pass-input\"\n                        type=\"password\"\n                        required\n                        placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                        value={adminPassword}\n                        onChange={(e) => setAdminPassword(e.target.value)}\n                        className=\"w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded focus:border-stone-900 focus:outline-none transition-colors\"\n                      />\n                    </div>\n\n                    {adminError && (\n                      <p className=\"text-red-500 text-[10px] font-serif italic text-center select-none pt-1\">{adminError}</p>\n                    )}\n\n                    <button\n                      type=\"submit\"\n                      className=\"w-full py-2 bg-stone-950 text-white rounded text-xs font-mono font-medium tracking-wide hover:bg-stone-850 cursor-pointer active:scale-95 transition-all\"\n                    >\n                      AUTHENTICATE CONTROL\n                    </button>\n                  </form>\n\n                  <div className=\"bg-amber-50/70 border border-amber-200/60 p-3 rounded text-amber-900 space-y-1.5 pt-2\">\n                    <div className=\"flex items-center gap-1.5 text-xs font-semibold\">\n                      <Info size={12} className=\"text-amber-700\" />\n                      <span>ADMIN CREDENTIALS DETAILS:</span>\n                    </div>\n                    <div className=\"text-[11px] font-mono leading-relaxed space-y-0.5\">\n                      <div>Username: <strong className=\"font-bold underline\">admin</strong></div>\n                      <div>Password: <strong className=\"font-bold underline\">zeronews2026</strong></div>\n                    </div>\n                  </div>\n                </div>\n              ) : (\n                /* Authenticated Panel view Dashboard */\n                <div className=\"space-y-6\">\n                  {/* Internal Subtabs */}\n                  <div className=\"flex border-b border-stone-200 gap-2 font-mono text-xs\">\n                    <button\n                      onClick={() => { setAdminSubView(\"list\"); resetAdminForm(); }}\n                      className={`pb-2 px-3 border-b-2 font-medium ${adminSubView === \"list\" ? \"border-stone-950 text-stone-900 font-bold\" : \"border-transparent text-stone-400 hover:text-stone-600 cursor-pointer\"}`}\n                    >\n                      ARTICLES INDEX ({posts.length})\n                    </button>\n                    <button\n                      onClick={() => { setAdminSubView(\"new\"); resetAdminForm(); }}\n                      className={`pb-2 px-3 border-b-2 font-medium ${adminSubView === \"new\" ? \"border-stone-950 text-stone-900 font-bold\" : \"border-transparent text-stone-400 hover:text-stone-600 cursor-pointer\"}`}\n                    >\n                      + WRITE NEW POST\n                    </button>\n                  </div>\n\n                  {adminSubView === \"list\" ? (\n                    /* Article listing interface inside admin panel */\n                    <div className=\"space-y-6\">\n                      <div className=\"flex items-center justify-between\">\n                        <h3 className=\"text-sm font-mono font-bold uppercase tracking-wider text-stone-700\">Dynamic Articles Index</h3>\n                        <button\n                          onClick={() => { setAdminSubView(\"new\"); resetAdminForm(); }}\n                          className=\"px-3 py-1 bg-stone-950 hover:bg-stone-800 text-white text-[10px] font-mono uppercase tracking-wider rounded flex items-center gap-1 pointer-events-auto cursor-pointer\"\n                        >\n                          <Plus size={11} /> Create Post\n                        </button>\n                      </div>\n\n                      <div className=\"border border-stone-200 rounded-md bg-white overflow-hidden shadow-sm\">\n                        <div className=\"overflow-x-auto\">\n                          <table className=\"w-full text-left border-collapse text-xs font-mono\">\n                            <thead>\n                              <tr className=\"bg-stone-50 border-b border-stone-200 text-stone-500 text-[10px]\">\n                                <th className=\"p-3 uppercase\">Title</th>\n                                <th className=\"p-3 uppercase\">Category</th>\n                                <th className=\"p-3 uppercase\">Author</th>\n                                <th className=\"p-3 uppercase text-right\">Actions</th>\n                              </tr>\n                            </thead>\n                            <tbody className=\"divide-y divide-stone-100\">\n                              {posts.map((post) => (\n                                <tr key={post.id} className=\"hover:bg-stone-50/50\">\n                                  <td className=\"p-3 font-semibold text-stone-900\">{post.title}</td>\n                                  <td className=\"p-3 text-stone-500 uppercase text-[10px]\">\n                                    <span className=\"bg-stone-100 p-1 px-1.5 rounded\">{post.category}</span>\n                                  </td>\n                                  <td className=\"p-3 text-stone-500\">{post.author}</td>\n                                  <td className=\"p-3 text-right space-x-1.5 whitespace-nowrap\">\n                                    <button\n                                      onClick={() => startEditPost(post)}\n                                      className=\"p-1 px-2 border border-stone-200 hover:border-stone-900 bg-white hover:bg-stone-50 text-stone-700 hover:text-stone-950 rounded transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                                      title=\"Edit story\"\n                                    >\n                                      <Edit size={11} /> Edit\n                                    </button>\n                                    <button\n                                      onClick={() => handleDeletePost(post.id)}\n                                      className=\"p-1 px-2 border border-red-200 hover:bg-red-50 text-red-600 hover:text-red-700 rounded transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                                      title=\"Delete file permanently\"\n                                    >\n                                      <Trash2 size={11} /> Delete\n                                    </button>\n                                  </td>\n                                </tr>\n                              ))}\n                            </tbody>\n                          </table>\n                        </div>\n                      </div>\n\n                      {/* Display newsletter signups section */}\n                      <div className=\"border border-stone-200 rounded-md bg-stone-50 p-4 space-y-3\">\n                        <div className=\"flex items-center justify-between border-b border-stone-200/60 pb-2\">\n                          <h4 className=\"text-xs font-mono font-bold uppercase tracking-wider text-stone-700 flex items-center gap-1\">\n                            <Mail size={12} className=\"text-stone-500\" />\n                            Newsletter Signups ({newsletterEmails.length})\n                          </h4>\n                          <button\n                            onClick={fetchNewsletterEmails}\n                            className=\"text-[10px] text-stone-500 hover:text-stone-900 transition-colors uppercase font-bold tracking-wider underline cursor-pointer\"\n                          >\n                            Refresh\n                          </button>\n                        </div>\n                        {newsletterEmails.length === 0 ? (\n                          <p className=\"text-[11px] text-stone-400 italic font-mono p-2\">No active email subscriptions found in the store.</p>\n                        ) : (\n                          <div className=\"flex flex-wrap gap-1.5 pt-1\">\n                            {newsletterEmails.map((email, idx) => (\n                              <span key={idx} className=\"bg-white border border-stone-200 text-stone-600 p-1 px-2 rounded font-mono text-[10px]\">\n                                {email}\n                              </span>\n                            ))}\n                          </div>\n                        )}\n                      </div>\n                    </div>\n                  ) : (\n                    /* Writing or Editing subview form */\n                    <form onSubmit={handleAdminFormSubmit} className=\"space-y-4 border border-stone-200/80 bg-white p-5 rounded-md shadow-sm\">\n                      <div className=\"flex items-center justify-between border-b border-stone-100 pb-3\">\n                        <h3 className=\"text-xs font-mono font-bold uppercase tracking-wider text-stone-500\">\n                          {adminSubView === \"edit\" ? `Edit Post [ ${formId} ]` : \"Create New Post\"}\n                        </h3>\n                        <button\n                          type=\"button\"\n                          onClick={() => { setAdminSubView(\"list\"); resetAdminForm(); }}\n                          className=\"text-stone-400 hover:text-stone-900 font-mono text-xs uppercase cursor-pointer\"\n                        >\n                          Cancel\n                        </button>\n                      </div>\n\n                      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                        <div>\n                          <label className=\"block text-[10px] font-mono text-stone-500 uppercase tracking-wider font-bold mb-1\" htmlFor=\"post-id\">Post ID (File slug)</label>\n                          <input\n                            id=\"post-id\"\n                            type=\"text\"\n                            required\n                            disabled={adminSubView === \"edit\"}\n                            placeholder=\"e.g., dynamic-seo-tips (no spaces)\"\n                            value={formId}\n                            onChange={(e) => setFormId(e.target.value.toLowerCase().replace(/[^a-z0-9-_]/g, \'-\'))}\n                            className=\"w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded focus:border-stone-900 focus:outline-none transition-colors font-mono disabled:opacity-50\"\n                          />\n                        </div>\n\n                        <div>\n                          <label className=\"block text-[10px] font-mono text-stone-500 uppercase tracking-wider font-bold mb-1\" htmlFor=\"post-title\">Article Title</label>\n                          <input\n                            id=\"post-title\"\n                            type=\"text\"\n                            required\n                            placeholder=\"e.g., Responsive Design Rules in 2026\"\n                            value={formTitle}\n                            onChange={(e) => setFormTitle(e.target.value)}\n                            className=\"w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded focus:border-stone-900 focus:outline-none transition-colors\"\n                          />\n                        </div>\n\n                        <div>\n                          <label className=\"block text-[10px] font-mono text-stone-500 uppercase tracking-wider font-bold mb-1\" htmlFor=\"post-category\">Category</label>\n                          <select\n                            id=\"post-category\"\n                            value={formCategory}\n                            onChange={(e) => setFormCategory(e.target.value)}\n                            className=\"w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded focus:border-stone-900 focus:outline-none transition-colors font-mono cursor-pointer\"\n                          >\n                            <option value=\"Design\">Design</option>\n                            <option value=\"Speed\">Speed</option>\n                            <option value=\"Trends\">Trends</option>\n                            <option value=\"News\">News</option>\n                            <option value=\"Technology\">Technology</option>\n                          </select>\n                        </div>\n\n                        <div>\n                          <label className=\"block text-[10px] font-mono text-stone-500 uppercase tracking-wider font-bold mb-1\" htmlFor=\"post-author\">Author Name</label>\n                          <input\n                            id=\"post-author\"\n                            type=\"text\"\n                            placeholder=\"e.g. Julian Drake\"\n                            value={formAuthor}\n                            onChange={(e) => setFormAuthor(e.target.value)}\n                            className=\"w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded focus:border-stone-900 focus:outline-none transition-colors font-mono\"\n                          />\n                        </div>\n\n                        <div className=\"md:col-span-2\">\n                          <label className=\"block text-[10px] font-mono text-stone-500 uppercase tracking-wider font-bold mb-1\" htmlFor=\"post-excerpt\">Short Excerpt Summary (Displayed on index lists)</label>\n                          <input\n                            id=\"post-excerpt\"\n                            type=\"text\"\n                            placeholder=\"Provide a 1-2 sentence compelling summary of the article...\"\n                            value={formExcerpt}\n                            onChange={(e) => setFormExcerpt(e.target.value)}\n                            className=\"w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded focus:border-stone-900 focus:outline-none transition-colors\"\n                          />\n                        </div>\n\n                        <div>\n                          <label className=\"block text-[10px] font-mono text-stone-500 uppercase tracking-wider font-bold mb-1\" htmlFor=\"post-reading-time\">Read Time</label>\n                          <input\n                            id=\"post-reading-time\"\n                            type=\"text\"\n                            placeholder=\"e.g. 4 min read\"\n                            value={formReadTime}\n                            onChange={(e) => setFormReadTime(e.target.value)}\n                            className=\"w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded focus:border-stone-900 focus:outline-none transition-colors font-mono\"\n                          />\n                        </div>\n                      </div>\n\n                      <div>\n                        <label className=\"block text-[10px] font-mono text-stone-500 tracking-wider uppercase font-bold mb-1\" htmlFor=\"post-content\">Markdown Body Content</label>\n                        <textarea\n                          id=\"post-content\"\n                          required\n                          rows={12}\n                          placeholder=\"# Write your article context here...\"\n                          value={formContent}\n                          onChange={(e) => setFormContent(e.target.value)}\n                          className=\"w-full text-xs p-2.5 bg-stone-50 border border-stone-200 rounded focus:border-stone-900 focus:outline-none transition-colors font-mono resize-y min-h-[160px]\"\n                        ></textarea>\n                      </div>\n\n                      <div className=\"flex items-center justify-between pt-2 border-t border-stone-100\">\n                        {formStatus === \"success\" ? (\n                          <p className=\"text-emerald-600 text-[11px] font-mono uppercase font-bold tracking-wider flex items-center gap-1\">\n                            <Check size={12} /> Publication published securely.\n                          </p>\n                        ) : formStatus === \"error\" ? (\n                          <p className=\"text-red-500 text-[11.5px] font-mono font-bold uppercase tracking-wider\">\n                            Error writing post file. Recheck constraints.\n                          </p>\n                        ) : (\n                          <div />\n                        )}\n\n                        <div className=\"flex items-center gap-2\">\n                          <button\n                            type=\"button\"\n                            onClick={() => { setAdminSubView(\"list\"); resetAdminForm(); }}\n                            className=\"px-4 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-600 hover:text-stone-900 text-xs font-mono rounded cursor-pointer transition-all\"\n                          >\n                            CANCEL\n                          </button>\n                          <button\n                            type=\"submit\"\n                            disabled={formStatus === \"submitting\"}\n                            className=\"px-5 py-1.5 bg-stone-950 hover:bg-stone-850 text-white text-xs font-mono font-bold tracking-wider rounded uppercase active:scale-95 transition-all cursor-pointer disabled:opacity-50\"\n                          >\n                            {formStatus === \"submitting\" ? \"PREPARING...\" : \"COMMIT PUBLISH\"}\n                          </button>\n                        </div>\n                      </div>\n                    </form>\n                  )}\n                </div>\n              )}\n            </div>\n          ) : !selectedPostId ? ("
      }
      num_matches: 1
    }
  }
}

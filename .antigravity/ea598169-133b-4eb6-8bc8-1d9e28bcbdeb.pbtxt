        target_content: "@import url(\'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Share+Tech+Mono&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\');\n@import \"tailwindcss\";\n\n@theme {"
        replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Share+Tech+Mono&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\');\n@import \"tailwindcss\";\n\n/* Official Stack Sans Headline CDN Webfont */\n@font-face {\n  font-family: \'Stack Sans Headline\';\n  font-style: normal;\n  font-display: swap;\n  font-weight: 200 700;\n  src: url(https://cdn.jsdelivr.net/fontsource/fonts/stack-sans-headline:vf@latest/latin-wght-normal.woff2) format(\'woff2-variations\');\n  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;\n}\n\n/* Official Stack Sans Notch CDN Webfont */\n@font-face {\n  font-family: \'Stack Sans Notch\';\n  font-style: normal;\n  font-display: swap;\n  font-weight: 200 700;\n  src: url(https://cdn.jsdelivr.net/fontsource/fonts/stack-sans-notch:vf@latest/latin-wght-normal.woff2) format(\'woff2-variations\');\n  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;\n}\n\n@theme {"

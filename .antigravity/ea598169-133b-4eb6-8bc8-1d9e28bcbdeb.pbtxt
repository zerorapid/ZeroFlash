      replacement_content: "              {/* Minimal Category Tab Navbars */}\n              <div id=\"category-tabs\" className=\"flex items-center gap-2 overflow-x-auto pb-2 border-b border-stone-200/60 no-scrollbar mb-4\">\n                {categories.map((category) => (\n                  <button\n                    id={`tab-${category.toLowerCase().replace(/\\s+/g, \'-\')}`}\n                    key={category}\n                    onClick={() => setSelectedCategory(category)}\n                    className={`px-4 py-2.5 text-sm md:text-xs md:px-3 md:py-1 font-sans font-medium tracking-wide rounded-full transition-all whitespace-nowrap cursor-pointer ${\n                      selectedCategory === category\n                        ? \"bg-stone-950 text-white shadow-sm\"\n                        : \"bg-stone-100 text-stone-600 hover:text-stone-900 hover:bg-stone-200/80\"\n                    }`}\n                  >\n                    {category}\n                  </button>\n                ))}\n              </div>\n\n              {/* Dynamic Multiple Tags Filtering System */}\n              <div id=\"tags-filtering-system\" className=\"flex flex-wrap items-center gap-2 p-3 bg-stone-50 border border-stone-200/40 rounded-lg mb-8 text-xs\">\n                <span className=\"text-[10px] font-mono font-bold uppercase text-stone-500 tracking-wider flex items-center gap-1.5 shrink-0\">\n                  <Sparkles size={11} className=\"text-orange-600 animate-pulse\" />\n                  Filter by tags:\n                </span>\n                {Array.from(new Set(posts.flatMap(p => p.tags || []))).length === 0 ? (\n                  <span className=\"text-[10px] italic text-stone-400 font-mono\">No article tags available.</span>\n                ) : (\n                  Array.from(new Set(posts.flatMap(p => p.tags || []))).map((tag) => {\n                    const isSelected = selectedTags.includes(tag);\n                    return (\n                      <button\n                        key={tag}\n                        onClick={() => handleTagToggle(tag)}\n                        className={`p-1 px-2.5 rounded font-mono text-[10px] uppercase font-semibold transition-all cursor-pointer ${\n                          isSelected\n                            ? \"bg-amber-850 text-stone-50 border border-amber-850 shadow-sm\"\n                            : \"bg-white border border-stone-200 text-stone-600 hover:bg-stone-100/50\"\n                        }`}\n                      >\n                        #{tag}\n                      </button>\n                    );\n                  })\n                )}\n                {selectedTags.length > 0 && (\n                  <button\n                    onClick={() => setSelectedTags([])}\n                    className=\"text-[10px] font-mono text-stone-500 hover:text-stone-900 underline ml-auto uppercase font-bold cursor-pointer\"\n                  >\n                    Clear Filter ({selectedTags.length})\n                  </button>\n                )}\n              </div>"

      target_content: "                  {/* Internal Subtabs */}\n                  <div className=\"flex border-b border-stone-200 gap-2 font-mono text-xs\">\n                    <button\n                      onClick={() => { setAdminSubView(\"list\"); resetAdminForm(); }}\n                      className={`pb-2 px-3 border-b-2 font-medium ${adminSubView === \"list\" ? \"border-stone-950 text-stone-900 font-bold\" : \"border-transparent text-stone-400 hover:text-stone-600 cursor-pointer\"}`}\n                    >\n                      ARTICLES INDEX ({posts.length})\n                    </button>\n                    <button\n                      onClick={() => { setAdminSubView(\"new\"); resetAdminForm(); }}\n                      className={`pb-2 px-3 border-b-2 font-medium ${adminSubView === \"new\" ? \"border-stone-950 text-stone-900 font-bold\" : \"border-transparent text-stone-400 hover:text-stone-600 cursor-pointer\"}`}\n                    >\n                      + WRITE NEW POST\n                    </button>\n                  </div>\n\n                  {adminSubView === \"list\" ? (\n                    /* Article listing interface inside admin panel */\n                    <div className=\"space-y-6\">\n                      <div className=\"flex items-center justify-between\">\n                        <h3 className=\"text-sm font-mono font-bold uppercase tracking-wider text-stone-700\">Dynamic Articles Index</h3>\n                        <button\n                          onClick={() => { setAdminSubView(\"new\"); resetAdminForm(); }}\n                          className=\"px-3 py-1 bg-stone-950 hover:bg-stone-800 text-white text-[10px] font-mono uppercase tracking-wider rounded flex items-center gap-1 pointer-events-auto cursor-pointer\"\n                        >\n                          <Plus size={11} /> Create Post\n                        </button>\n                      </div>\n\n                      <div className=\"border border-stone-200 rounded-md bg-white overflow-hidden shadow-sm\">\n                        <div className=\"overflow-x-auto\">\n                          <table className=\"w-full text-left border-collapse text-xs font-mono\">\n                            <thead>\n                              <tr className=\"bg-stone-50 border-b border-stone-200 text-stone-500 text-[10px]\">\n                                <th className=\"p-3 uppercase\">Title</th>\n                                <th className=\"p-3 uppercase\">Category</th>\n                                <th className=\"p-3 uppercase\">Author</th>\n                                <th className=\"p-3 uppercase text-right\">Actions</th>\n                              </tr>\n                            </thead>\n                            <tbody className=\"divide-y divide-stone-100\">\n                              {posts.map((post) => (\n                                <tr key={post.id} className=\"hover:bg-stone-50/50\">\n                                  <td className=\"p-3 font-semibold text-stone-900\">{post.title}</td>\n                                  <td className=\"p-3 text-stone-500 uppercase text-[10px]\">\n                                    <span className=\"bg-stone-100 p-1 px-1.5 rounded\">{post.category}</span>\n                                  </td>\n                                  <td className=\"p-3 text-stone-500\">{post.author}</td>\n                                  <td className=\"p-3 text-right space-x-1.5 whitespace-nowrap\">\n                                    <button\n                                      onClick={() => startEditPost(post)}\n                                      className=\"p-1 px-2 border border-stone-200 hover:border-stone-900 bg-white hover:bg-stone-50 text-stone-700 hover:text-stone-950 rounded transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                                      title=\"Edit story\"\n                                    >\n                                      <Edit size={11} /> Edit\n                                    </button>\n                                    <button\n                                      onClick={() => handleDeletePost(post.id)}\n                                      className=\"p-1 px-2 border border-red-200 hover:bg-red-50 text-red-600 hover:text-red-700 rounded transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                                      title=\"Delete file permanently\"\n                                    >\n                                      <Trash2 size={11} /> Delete\n                                    </button>\n                                  </td>\n                                </tr>\n                              ))}\n                            </tbody>\n                          </table>\n                        </div>\n                      </div>\n\n                      {/* Display newsletter signups section */}\n                      <div className=\"border border-stone-200 rounded-md bg-stone-50 p-4 space-y-3\">\n                        <div className=\"flex items-center justify-between border-b border-stone-200/60 pb-2\">\n                          <h4 className=\"text-xs font-mono font-bold uppercase tracking-wider text-stone-700 flex items-center gap-1\">\n                            <Mail size={12} className=\"text-stone-500\" />\n                            Newsletter Signups ({newsletterEmails.length})\n                          </h4>\n                          <button\n                            onClick={fetchNewsletterEmails}\n                            className=\"text-[10px] text-stone-500 hover:text-stone-900 transition-colors uppercase font-bold tracking-wider underline cursor-pointer\"\n                          >\n                            Refresh\n                          </button>\n                        </div>\n                        {newsletterEmails.length === 0 ? (\n                          <p className=\"text-[11px] text-stone-400 italic font-mono p-2\">No active email subscriptions found in the store.</p>\n                        ) : (\n                          <div className=\"flex flex-wrap gap-1.5 pt-1\">\n                            {newsletterEmails.map((email, idx) => (\n                              <span key={idx} className=\"bg-white border border-stone-200 text-stone-600 p-1 px-2 rounded font-mono text-[10px]\">\n                                {email}\n                              </span>\n                            ))}\n                          </div>\n                        )}\n                      </div>\n                    </div>\n                  ) : (\n                    /* Writing or Editing subview form */\n                    <form onSubmit={handleAdminFormSubmit} className=\"space-y-4 border border-stone-200/80 bg-white p-5 rounded-md shadow-sm\">\n                      <div className=\"flex items-center justify-between border-b border-stone-100 pb-3\">\n                        <h3 className=\"text-xs font-mono font-bold uppercase tracking-wider text-stone-500\">\n                          {adminSubView === \"edit\" ? `Edit Post [ ${formId} ]` : \"Create New Post\"}\n                        </h3>"
      replacement_content: "                  {/* Internal Subtabs */}\n                  <div className=\"flex flex-wrap border-b border-stone-200 mt-2 gap-y-1 gap-x-1.5 font-mono text-xs\">\n                    <button\n                      id=\"admin-tab-articles\"\n                      type=\"button\"\n                      onClick={() => { setAdminSubView(\"list\"); resetAdminForm(); }}\n                      className={`pb-2 px-3 border-b-2 font-medium ${adminSubView === \"list\" ? \"border-stone-950 text-stone-900 font-bold\" : \"border-transparent text-stone-400 hover:text-stone-600 cursor-pointer\"}`}\n                    >\n                      ARTICLES INDEX ({posts.length})\n                    </button>\n                    <button\n                      id=\"admin-tab-write\"\n                      type=\"button\"\n                      onClick={() => { setAdminSubView(\"new\"); resetAdminForm(); }}\n                      className={`pb-2 px-3 border-b-2 font-medium ${(adminSubView === \"new\" || adminSubView === \"edit\") ? \"border-stone-950 text-stone-900 font-bold\" : \"border-transparent text-stone-400 hover:text-stone-600 cursor-pointer\"}`}\n                    >\n                      + WRITE NEW POST\n                    </button>\n                    <button\n                      id=\"admin-tab-comments\"\n                      type=\"button\"\n                      onClick={() => { setAdminSubView(\"comments\"); fetchAllComments(); }}\n                      className={`pb-2 px-3 border-b-2 font-medium ${adminSubView === \"comments\" ? \"border-stone-950 text-stone-900 font-bold\" : \"border-transparent text-stone-400 hover:text-stone-600 cursor-pointer\"}`}\n                    >\n                      MODERATE COMMENTS ({allComments.filter(c => !c.approved).length})\n                    </button>\n                    <button\n                      id=\"admin-tab-images\"\n                      type=\"button\"\n                      onClick={() => { setAdminSubView(\"images\"); fetchUploadedImages(); }}\n                      className={`pb-2 px-3 border-b-2 font-medium ${adminSubView === \"images\" ? \"border-stone-950 text-stone-900 font-bold\" : \"border-transparent text-stone-400 hover:text-stone-600 cursor-pointer\"}`}\n                    >\n                      CUSTOM VISUALS ({uploadedImages.length})\n                    </button>\n                    <button\n                      id=\"admin-tab-emails\"\n                      type=\"button\"\n                      onClick={() => { setAdminSubView(\"emails\"); fetchEmailLogs(); }}\n                      className={`pb-2 px-3 border-b-2 font-medium ${adminSubView === \"emails\" ? \"border-stone-950 text-stone-900 font-bold\" : \"border-transparent text-stone-400 hover:text-stone-600 cursor-pointer\"}`}\n                    >\n                      EMAIL NOTIFICATIONS ({allEmailLogs.length})\n                    </button>\n                  </div>\n\n                  {adminSubView === \"list\" ? (\n                    /* Article listing interface inside admin panel */\n                    <div className=\"space-y-6\">\n                      <div className=\"flex items-center justify-between\">\n                        <h3 className=\"text-sm font-mono font-bold uppercase tracking-wider text-stone-700\">Dynamic Articles Index</h3>\n                        <button\n                          onClick={() => { setAdminSubView(\"new\"); resetAdminForm(); }}\n                          className=\"px-3 py-1 bg-stone-950 hover:bg-stone-800 text-white text-[10px] font-mono uppercase tracking-wider rounded flex items-center gap-1 pointer-events-auto cursor-pointer\"\n                        >\n                          <Plus size={11} /> Create Post\n                        </button>\n                      </div>\n\n                      <div className=\"border border-stone-200 rounded-md bg-white overflow-hidden shadow-sm\">\n                        <div className=\"overflow-x-auto\">\n                          <table className=\"w-full text-left border-collapse text-xs font-mono\">\n                            <thead>\n                              <tr className=\"bg-stone-50 border-b border-stone-200 text-stone-500 text-[10px]\">\n                                <th className=\"p-3 uppercase\">Title</th>\n                                <th className=\"p-3 uppercase\">Category</th>\n                                <th className=\"p-3 uppercase\">Author</th>\n                                <th className=\"p-3 uppercase text-right\">Actions</th>\n                              </tr>\n                            </thead>\n                            <tbody className=\"divide-y divide-stone-100\">\n                              {posts.map((post) => (\n                                <tr key={post.id} className=\"hover:bg-stone-50/50\">\n                                  <td className=\"p-3 font-semibold text-stone-900\">{post.title}</td>\n                                  <td className=\"p-3 text-stone-500 uppercase text-[10px]\">\n                                    <span className=\"bg-stone-100 p-1 px-1.5 rounded\">{post.category}</span>\n                                  </td>\n                                  <td className=\"p-3 text-stone-500\">{post.author}</td>\n                                  <td className=\"p-3 text-right space-x-1.5 whitespace-nowrap\">\n                                    <button\n                                      onClick={() => startEditPost(post)}\n                                      className=\"p-1 px-2 border border-stone-200 hover:border-stone-900 bg-white hover:bg-stone-50 text-stone-700 hover:text-stone-950 rounded transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                                      title=\"Edit story\"\n                                    >\n                                      <Edit size={11} /> Edit\n                                    </button>\n                                    <button\n                                      onClick={() => handleDeletePost(post.id)}\n                                      className=\"p-1 px-2 border border-red-200 hover:bg-red-50 text-red-600 hover:text-red-700 rounded transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                                      title=\"Delete file permanently\"\n                                    >\n                                      <Trash2 size={11} /> Delete\n                                    </button>\n                                  </td>\n                                </tr>\n                              ))}\n                            </tbody>\n                          </table>\n                        </div>\n                      </div>\n\n                      {/* Display newsletter signups section */}\n                      <div className=\"border border-stone-200 rounded-md bg-stone-50 p-4 space-y-3\">\n                        <div className=\"flex items-center justify-between border-b border-stone-200/60 pb-2\">\n                          <h4 className=\"text-xs font-mono font-bold uppercase tracking-wider text-stone-700 flex items-center gap-1\">\n                            <Mail size={12} className=\"text-stone-500\" />\n                            Newsletter Signups ({newsletterEmails.length})\n                          </h4>\n                          <button\n                            onClick={fetchNewsletterEmails}\n                            className=\"text-[10px] text-stone-500 hover:text-stone-900 transition-colors uppercase font-bold tracking-wider underline cursor-pointer\"\n                          >\n                            Refresh\n                          </button>\n                        </div>\n                        {newsletterEmails.length === 0 ? (\n                          <p className=\"text-[11px] text-stone-400 italic font-mono p-2\">No active email subscriptions found in the store.</p>\n                        ) : (\n                          <div className=\"flex flex-wrap gap-1.5 pt-1\">\n                            {newsletterEmails.map((email, idx) => (\n                              <span key={idx} className=\"bg-white border border-stone-200 text-stone-600 p-1 px-2 rounded font-mono text-[10px]\">\n                                {email}\n                              </span>\n                            ))}\n                          </div>\n                        )}\n                      </div>\n                    </div>\n                  ) : adminSubView === \"comments\" ? (\n                    /* Comments Moderation Subview */\n                    <div className=\"space-y-6\">\n                      <div className=\"flex items-center justify-between\">\n                        <h3 className=\"text-sm font-mono font-bold uppercase tracking-wider text-stone-700\">Comments Moderation Hub</h3>\n                        <button\n                          onClick={fetchAllComments}\n                          className=\"text-[10px] font-mono text-stone-500 hover:text-stone-950 font-bold underline cursor-pointer uppercase tracking-wider\"\n                        >\n                          Refresh Logs\n                        </button>\n                      </div>\n\n                      <div className=\"border border-stone-200 rounded-md bg-white overflow-hidden shadow-sm\">\n                        <div className=\"overflow-x-auto\">\n                          <table className=\"w-full text-left border-collapse text-xs font-mono\">\n                            <thead>\n                              <tr className=\"bg-stone-50 border-b border-stone-200 text-stone-500 text-[10px]\">\n                                <th className=\"p-3 uppercase\">Author</th>\n                                <th className=\"p-3 uppercase\">Comment Content</th>\n                                <th className=\"p-3 uppercase\">Target Post</th>\n                                <th className=\"p-3 uppercase\">Status</th>\n                                <th className=\"p-3 uppercase text-right\">Moderator Actions</th>\n                              </tr>\n                            </thead>\n                            <tbody className=\"divide-y divide-stone-100\">\n                              {allComments.length === 0 ? (\n                                <tr>\n                                  <td colSpan={5} className=\"p-8 text-center text-stone-400 italic\">\n                                    No commenter submission logs available.\n                                  </td>\n                                </tr>\n                              ) : (\n                                allComments.map((comment) => (\n                                  <tr key={comment.id} className=\"hover:bg-stone-50/20\">\n                                    <td className=\"p-3 font-semibold text-stone-900 whitespace-nowrap\">{comment.author}</td>\n                                    <td className=\"p-3 text-stone-600 max-w-xs truncate\" title={comment.content}>\n                                      {comment.content}\n                                    </td>\n                                    <td className=\"p-3 text-stone-400 text-[10px] uppercase font-bold truncate\">\n                                      {comment.postId || \"Unknown Article\"}\n                                    </td>\n                                    <td className=\"p-3 text-[10px] font-mono whitespace-nowrap\">\n                                      {comment.approved ? (\n                                        <span className=\"bg-emerald-50 border border-emerald-100 text-emerald-700 p-0.5 px-2 rounded-full inline-block font-semibold\">\n                                          \342\227\217 APPROVED\n                                        </span>\n                                      ) : (\n                                        <span className=\"bg-amber-50 border border-amber-100 text-amber-700 p-0.5 px-2 rounded-full inline-block font-semibold\">\n                                          \342\227\217 PENDING\n                                        </span>\n                                      )}\n                                    </td>\n                                    <td className=\"p-3 text-right space-x-1.5 whitespace-nowrap\">\n                                      {!comment.approved && (\n                                        <button\n                                          onClick={() => handleApproveComment(comment.id)}\n                                          className=\"p-1 px-2 border border-emerald-200 hover:bg-emerald-50 text-emerald-700 hover:text-emerald-800 rounded transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                                        >\n                                          <Check size={11} /> Approve\n                                        </button>\n                                      )}\n                                      <button\n                                        onClick={() => handleRejectComment(comment.id)}\n                                        className=\"p-1 px-2 border border-red-200 hover:bg-red-50 text-red-600 hover:text-red-700 rounded transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                                      >\n                                        <Trash2 size={11} /> Delete\n                                      </button>\n                                    </td>\n                                  </tr>\n                                ))\n                              )}\n                            </tbody>\n                          </table>\n                        </div>\n                      </div>\n                    </div>\n                  ) : adminSubView === \"images\" ? (\n                    /* Custom Visuals Upload Subview */\n                    <div className=\"space-y-6\">\n                      <div className=\"flex items-center justify-between\">\n                        <h3 className=\"text-sm font-mono font-bold uppercase tracking-wider text-stone-700\">Custom Article Visuals Directory</h3>\n                      </div>\n\n                      {/* Photo/Asset Upload Widget */}\n                      <div className=\"p-5 border border-dashed border-stone-300 rounded-md bg-stone-50/50 flex flex-col items-center justify-center text-center space-y-4\">\n                        <Upload size={24} className=\"text-stone-400\" />\n                        <div className=\"space-y-1\">\n                          <p className=\"text-xs font-mono font-bold text-stone-800\">DRAG & DROP OR CHOOSE IMAGE</p>\n                          <p className=\"text-[10px] font-mono text-stone-400\">Supported types: PNG, JPEG, GIF, WEBP up to 8MB max</p>\n                        </div>\n                        <input\n                          type=\"file\"\n                          id=\"visuals-file-picker\"\n                          accept=\"image/*\"\n                          className=\"hidden\"\n                          onChange={(e) => {\n                            const file = e.target.files?.[0];\n                            if (file) handleImageUpload(file);\n                          }}\n                        />\n                        <button\n                          type=\"button\"\n                          onClick={() => document.getElementById(\"visuals-file-picker\")?.click()}\n                          disabled={imageUploading}\n                          className=\"px-4 py-1.5 bg-stone-900 hover:bg-stone-800 disabled:opacity-55 text-white font-mono text-[10px] uppercase rounded transition-colors cursor-pointer\"\n                        >\n                          {imageUploading ? \"Writing File...\" : \"SELECT FILE\"}\n                        </button>\n                        {uploadError && (\n                          <p className=\"text-red-600 font-mono text-[10px] uppercase\">{uploadError}</p>\n                        )}\n                      </div>\n\n                      {/* Display image library files index */}\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4\">\n                        {uploadedImages.length === 0 ? (\n                          <div className=\"col-span-full py-8 text-center text-stone-400 text-xs italic font-mono bg-white border border-stone-200/50 rounded p-4\">\n                            You have not uploaded any article custom visual assets.\n                          </div>\n                        ) : (\n                          uploadedImages.map((img) => (\n                            <div key={img.name} className=\"border border-stone-200 bg-white rounded-md overflow-hidden p-2 flex flex-col space-y-2 group shadow-sm\">\n                              <div className=\"aspect-[16/9] bg-stone-50 flex items-center justify-center border border-stone-100 rounded overflow-hidden relative\">\n                                <img\n                                  src={img.url}\n                                  alt={img.name}\n                                  referrerPolicy=\"no-referrer\"\n                                  className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-200\"\n                                />\n                              </div>\n                              <div className=\"space-y-1\">\n                                <p className=\"text-[10px] font-mono font-bold text-stone-800 truncate\" title={img.name}>{img.name}</p>\n                                <p className=\"text-[8px] font-mono text-stone-400\">Uploaded: {new Date(img.uploadedAt).toLocaleString()}</p>\n                              </div>\n                              <div className=\"flex gap-1.5 pt-1\">\n                                <button\n                                  type=\"button\"\n                                  onClick={() => {\n                                    navigator.clipboard.writeText(`![${img.name}](${img.url})`);\n                                    setCopiedImageName(img.name);\n                                    setTimeout(() => setCopiedImageName(null), 2000);\n                                  }}\n                                  className=\"flex-1 py-1 bg-stone-100 hover:bg-stone-200 text-[#121212] font-mono text-[9px] uppercase font-bold rounded text-center transition-colors cursor-pointer\"\n                                >\n                                  {copiedImageName === img.name ? \"COPIED MATCH!\" : \"COPY LINK\"}\n                                </button>\n                                <button\n                                  type=\"button\"\n                                  onClick={() => handleDeleteImage(img.name)}\n                                  className=\"p-1 px-1.5 border border-red-100 hover:bg-red-50 text-red-600 hover:text-red-700 rounded transition-colors cursor-pointer\"\n                                  title=\"Delete visual asset from storage permanently\"\n                                >\n                                  <Trash2 size={10} />\n                                </button>\n                              </div>\n                            </div>\n                          ))\n                        )}\n                      </div>\n                    </div>\n                  ) : adminSubView === \"emails\" ? (\n                    /* Emails Log Subview */\n                    <div className=\"space-y-6\">\n                      <div className=\"flex items-center justify-between\">\n                        <h3 className=\"text-sm font-mono font-bold uppercase tracking-wider text-stone-700\">Simulated Email Alerts Notification Server Logs</h3>\n                        <button\n                          onClick={fetchEmailLogs}\n                          className=\"text-[10px] font-mono text-stone-500 hover:text-stone-950 font-bold underline cursor-pointer uppercase tracking-wider\"\n                        >\n                          Refresh Alerts Listing\n                        </button>\n                      </div>\n\n                      <div className=\"space-y-3\">\n                        {allEmailLogs.length === 0 ? (\n                          <div className=\"p-8 text-center text-stone-400 text-xs italic font-mono bg-white border border-stone-200/50 rounded-md\">\n                            No active backend event notification emails logged in the simulated server memory.\n                          </div>\n                        ) : (\n                          allEmailLogs.map((email) => (\n                            <div key={email.id} className=\"p-4 bg-white border border-stone-200 rounded-md font-mono text-xs space-y-2 relative shadow-sm\">\n                              <div className=\"flex flex-wrap items-center justify-between gap-2 text-[10px] text-stone-500 border-b border-stone-100 pb-2\">\n                                <span className=\"flex items-center gap-1 font-bold text-stone-700\">\n                                  <Mail size={12} className=\"text-orange-505\" />\n                                  TO MODERATOR: {email.to}\n                                </span>\n                                <span>Sent: {new Date(email.timestamp).toLocaleString()}</span>\n                              </div>\n                              <div className=\"space-y-1\">\n                                <p className=\"text-stone-800 font-bold\">SUBJECT: {email.subject}</p>\n                                <p className=\"text-stone-500 text-[11px] whitespace-pre-line leading-relaxed bg-stone-50 p-2 border border-stone-200/40 rounded mt-1.5\">\n                                  {email.body}\n                                </p>\n                              </div>\n                            </div>\n                          ))\n                        )}\n                      </div>\n                    </div>\n                  ) : (\n                    /* Writing or Editing subview form */\n                    <form onSubmit={handleAdminFormSubmit} className=\"space-y-4 border border-stone-200/80 bg-white p-5 rounded-md shadow-sm\">\n                      <div className=\"flex items-center justify-between border-b border-stone-100 pb-3\">\n                        <h3 className=\"text-xs font-mono font-bold uppercase tracking-wider text-stone-500 font-bold\">\n                          {adminSubView === \"edit\" ? `Edit Post [ ${formId} ]` : \"Create New Post\"}\n                        </h3>"
    }
    instruction: "Implement multi-view navigation inside administrative panel workspace."
  }
}

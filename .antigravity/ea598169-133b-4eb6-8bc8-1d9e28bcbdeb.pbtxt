    instruction: "Add post sharing and admin panel states, plus highlightText helper inside App.tsx"
    replacement_infos {
      original_chunk {
        target_content: "export default function App() {\n  const [posts, setPosts] = useState<Post[]>([]);\n  const [selectedPostId, setSelectedPostId] = useState<string | null>(null);\n  const [activePost, setActivePost] = useState<Post | null>(null);\n  const [comments, setComments] = useState<Comment[]>([]);\n  \n  // Filtering & Search\n  const [selectedCategory, setSelectedCategory] = useState<string>(\"All\");\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  \n  // Interactive UI Inputs\n  const [commentName, setCommentName] = useState(\"\");\n  const [commentBody, setCommentBody] = useState(\"\");\n  const [newsletterEmail, setNewsletterEmail] = useState(\"\");\n  \n  // Status/Loading States\n  const [loadingPosts, setLoadingPosts] = useState(true);\n  const [loadingContent, setLoadingContent] = useState(false);\n  const [commentingStatus, setCommentingStatus] = useState<\"idle\" | \"submitting\" | \"success\" | \"error\">(\"idle\");\n  const [newsletterStatus, setNewsletterStatus] = useState<\"idle\" | \"submitting\" | \"success\" | \"error\">(\"idle\");\n  const [showSeoExplain, setShowSeoExplain] = useState(false);"
        replacement_content: "export default function App() {\n  const [posts, setPosts] = useState<Post[]>([]);\n  const [selectedPostId, setSelectedPostId] = useState<string | null>(null);\n  const [activePost, setActivePost] = useState<Post | null>(null);\n  const [comments, setComments] = useState<Comment[]>([]);\n  \n  // Filtering & Search\n  const [selectedCategory, setSelectedCategory] = useState<string>(\"All\");\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  \n  // Interactive UI Inputs\n  const [commentName, setCommentName] = useState(\"\");\n  const [commentBody, setCommentBody] = useState(\"\");\n  const [newsletterEmail, setNewsletterEmail] = useState(\"\");\n  \n  // Status/Loading States\n  const [loadingPosts, setLoadingPosts] = useState(true);\n  const [loadingContent, setLoadingContent] = useState(false);\n  const [commentingStatus, setCommentingStatus] = useState<\"idle\" | \"submitting\" | \"success\" | \"error\">(\"idle\");\n  const [newsletterStatus, setNewsletterStatus] = useState<\"idle\" | \"submitting\" | \"success\" | \"error\">(\"idle\");\n  const [showSeoExplain, setShowSeoExplain] = useState(false);\n\n  // Social Share states\n  const [shareCopied, setShareCopied] = useState(false);\n\n  // Admin view & Login configurations\n  const [currentView, setCurrentView] = useState<\"blog\" | \"admin\">(\"blog\");\n  const [adminLoggedIn, setAdminLoggedIn] = useState(false);\n  const [adminUser, setAdminUser] = useState(\"\");\n  const [adminPassword, setAdminPassword] = useState(\"\");\n  const [adminError, setAdminError] = useState(\"\");\n\n  const [adminSubView, setAdminSubView] = useState<\"list\" | \"new\" | \"edit\">(\"list\");\n  const [newsletterEmails, setNewsletterEmails] = useState<string[]>([]);\n  const [editingPost, setEditingPost] = useState<Post | null>(null);\n\n  // Creating/Editing Form states\n  const [formId, setFormId] = useState(\"\");\n  const [formTitle, setFormTitle] = useState(\"\");\n  const [formCategory, setFormCategory] = useState(\"News\");\n  const [formAuthor, setFormAuthor] = useState(\"\");\n  const [formExcerpt, setFormExcerpt] = useState(\"\");\n  const [formReadTime, setFormReadTime] = useState(\"\");\n  const [formContent, setFormContent] = useState(\"\");\n  const [formStatus, setFormStatus] = useState<\"idle\" | \"submitting\" | \"success\" | \"error\">(\"idle\");\n\n  const resetAdminForm = () => {\n    setFormId(\"\");\n    setFormTitle(\"\");\n    setFormCategory(\"News\");\n    setFormAuthor(\"\");\n    setFormExcerpt(\"\");\n    setFormReadTime(\"\");\n    setFormContent(\"\");\n    setEditingPost(null);\n  };\n\n  const startEditPost = (post: Post) => {\n    setEditingPost(post);\n    setFormId(post.id);\n    setFormTitle(post.title);\n    setFormCategory(post.category);\n    setFormAuthor(post.author);\n    setFormExcerpt(post.excerpt);\n    setFormReadTime(post.readTime);\n    setFormContent(post.content || \"\");\n    setAdminSubView(\"edit\");\n  };\n\n  // Safe Highlight text generator\n  const highlightText = (text: string, query: string) => {\n    if (!query.trim()) return <span>{text}</span>;\n    // Split on query case insensitively by capturing group\n    const parts = text.split(new RegExp(`(${query.replace(/[-\\/\\\\^$*+?.()|[\\]{}]/g, \'\\\\$&\')})`, \'gi\'));\n    return (\n      <span>\n        {parts.map((p, i) => \n          p.toLowerCase() === query.toLowerCase() ? (\n            <strong key={i} className=\"font-extrabold text-stone-950 bg-amber-200/90 px-0.5 rounded-sm\">{p}</strong>\n          ) : (\n            p\n          )\n        )}\n      </span>\n    );\n  };\n\n  // Safe matched subtitle extractor\n  const getContentPreview = (content: string, query: string) => {\n    if (!query.trim() || !content) return null;\n    const lowerContent = content.toLowerCase();\n    const lowerQuery = query.toLowerCase();\n    const index = lowerContent.indexOf(lowerQuery);\n    if (index === -1) return null;\n    \n    const start = Math.max(0, index - 60);\n    const end = Math.min(content.length, index + query.length + 80);\n    \n    let snippet = content.slice(start, end);\n    if (start > 0) snippet = \"...\" + snippet;\n    if (end < content.length) snippet = snippet + \"...\";\n    \n    return snippet;\n  };\n\n  const fetchNewsletterEmails = async () => {\n    try {\n      const res = await fetch(\"/api/admin/newsletter\");\n      if (res.ok) {\n        const data = await res.json();\n        setNewsletterEmails(data);\n      }\n    } catch (err) {\n      console.error(\"Failed to fetch newsletters\", err);\n    }\n  };\n\n  const handleAdminLogin = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (adminUser === \"admin\" && adminPassword === \"zeronews2026\") {\n      setAdminLoggedIn(true);\n      setAdminError(\"\");\n      fetchNewsletterEmails();\n    } else {\n      setAdminError(\"Invalid user details. Look closely at the helper tip below!\");\n    }\n  };\n\n  const handleAdminFormSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formId.trim() || !formTitle.trim() || !formContent.trim()) {\n      setFormStatus(\"error\");\n      return;\n    }\n\n    try {\n      setFormStatus(\"submitting\");\n      const url = adminSubView === \"new\" ? \"/api/admin/posts\" : `/api/admin/posts/${editingPost?.id}`;\n      const method = adminSubView === \"new\" ? \"POST\" : \"PUT\";\n\n      const res = await fetch(url, {\n        method,\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          id: formId.trim(),\n          title: formTitle,\n          category: formCategory,\n          author: formAuthor,\n          excerpt: formExcerpt,\n          readTime: formReadTime,\n          content: formContent\n        })\n      });\n\n      if (res.ok) {\n        setFormStatus(\"success\");\n        fetchPosts(); // Reload index listings to sync\n        setTimeout(() => {\n          setFormStatus(\"idle\");\n          setAdminSubView(\"list\");\n          resetAdminForm();\n        }, 1500);\n      } else {\n        setFormStatus(\"error\");\n      }\n    } catch (err) {\n      console.error(err);\n      setFormStatus(\"error\");\n    }\n  };\n\n  const handleDeletePost = async (id: string) => {\n    if (!window.confirm(\"Are you sure you want to delete this article? This will remove the file permanently.\")) return;\n    try {\n      const res = await fetch(`/api/admin/posts/${id}`, {\n        method: \"DELETE\"\n      });\n      if (res.ok) {\n        setPosts((prev) => prev.filter((p) => p.id !== id));\n      } else {\n        alert(\"Failed to delete post.\");\n      }\n    } catch (err) {\n      console.error(err);\n    }\n  };"
      }
      num_matches: 1
    }
  }
}

    instruction: "Replace simple mobile sponsor card at the bottom of listings with a highly structured, dual-card responsive ad grid that adapts on tablet and mobile viewports."
    replacement_infos {
      original_chunk {
        target_content: "              {/* Mobile-friendly horizontal Ad banner fallback at the bottom of listings */}\n              <div id=\"mobile-sponsor-card\" className=\"block xl:hidden mt-12 p-5 bg-gradient-to-br from-stone-50 to-stone-100 rounded-md border border-stone-200 hover:border-stone-300 transition-colors\">\n                <div className=\"flex items-center justify-between font-mono text-[9px] text-stone-400 mb-2\">\n                  <span>[ MOB.ADVERT // SPONSORED ]</span>\n                  <span className=\"text-emerald-600 font-bold\">VERIFIED</span>\n                </div>\n                <h4 className=\"font-display font-extrabold text-base text-stone-950 uppercase tracking-tight mb-2\">\n                  Node Cloud Optimizer \'26\n                </h4>\n                <p className=\"text-stone-600 text-xs leading-relaxed mb-4\">\n                  Boost Largest Contentful Paint (LCP) down to 0.4 seconds with compile-to-CJS static file trees.\n                </p>\n                <a \n                  href=\"https://ai.studio/build\" \n                  target=\"_blank\"  \n                  rel=\"noopener noreferrer\"\n                  className=\"inline-block w-full py-2.5 bg-stone-950 hover:bg-stone-850 text-white font-bold text-center tracking-wider rounded uppercase text-xs active:scale-95 transition-all\"\n                >\n                  UPGRADE STORAGE GRIDS\n                </a>\n              </div>"
        replacement_content: "              {/* Responsive Bottom Banners (visible only below xl screens) */}\n              <div id=\"responsive-bottom-banners\" className=\"block xl:hidden mt-12 space-y-4\">\n                <div className=\"text-[10px] font-mono uppercase tracking-[0.2em] text-stone-400 mb-2 border-b border-stone-200/60 pb-1.5 flex justify-between items-center\">\n                  <span>[ CORRESPONDENCE SPONSORS ]</span>\n                  <span>SECURE CONNECTIONS</span>\n                </div>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  {/* Card 1 */}\n                  <div className=\"border border-stone-200/90 bg-stone-50/55 p-4 rounded-md flex flex-col justify-between font-mono text-[11px] relative overflow-hidden shadow-sm\">\n                    <div>\n                      <div className=\"absolute top-0 right-0 bg-orange-600 font-bold text-[7px] text-white px-1.5 py-0.5 uppercase tracking-widest rounded-bl\">\n                        SPONSOR 01\n                      </div>\n                      <div className=\"text-[9px] uppercase font-bold text-stone-400 tracking-wider mb-2\">\n                        [ HOSTING_NODE ]\n                      </div>\n                      <div className=\"flex gap-4 items-center mb-3\">\n                        <div className=\"w-16 h-16 shrink-0 bg-stone-900 rounded border border-stone-800 flex flex-col justify-center items-center p-1.5 text-center text-stone-100 relative overflow-hidden\">\n                          <Sparkles size={14} className=\"text-orange-400 animate-pulse mb-0.5\" />\n                          <div className=\"font-display font-bold text-[8px] uppercase text-white leading-none\">NODE COMPUTE</div>\n                        </div>\n                        <p className=\"text-stone-600 text-[11px] font-sans leading-normal\">\n                          Deploy flat-file markdown blogs on high-density static clouds with zero overhead.\n                        </p>\n                      </div>\n                    </div>\n                    <a \n                      href=\"https://ai.studio/build\" \n                      target=\"_blank\"  \n                      rel=\"noopener noreferrer\"\n                      className=\"block w-full py-2 bg-stone-950 hover:bg-stone-850 text-white font-bold text-center tracking-wider rounded uppercase text-[10px] active:scale-95 transition-all\"\n                    >\n                      LAUNCH INSTANCE\n                    </a>\n                  </div>\n\n                  {/* Card 2 */}\n                  <div className=\"border border-stone-200/90 bg-stone-50/55 p-4 rounded-md flex flex-col justify-between font-mono text-[11px] relative overflow-hidden shadow-sm\">\n                    <div>\n                      <div className=\"absolute top-0 right-0 bg-stone-950 font-bold text-[7px] text-white px-1.5 py-0.5 uppercase tracking-widest rounded-bl\">\n                        ADVERT 02\n                      </div>\n                      <div className=\"text-[9px] uppercase font-bold text-stone-400 tracking-wider mb-2\">\n                        [ META_OPTIMIZE ]\n                      </div>\n                      <div className=\"flex gap-4 items-center mb-3\">\n                        <div className=\"w-16 h-16 shrink-0 bg-stone-900 rounded border border-stone-800 flex flex-col justify-center items-center p-1.5 text-center text-stone-100 relative overflow-hidden\">\n                          <div className=\"font-display font-black text-xs text-emerald-500 leading-none\">SEO+</div>\n                          <div className=\"font-display font-bold text-[6px] text-stone-400 leading-none uppercase mt-0.5\">SCHEMA</div>\n                        </div>\n                        <p className=\"text-stone-600 text-[11px] font-sans leading-normal\">\n                          Inject optimal indexing structured objects and verified content arrays into search algorithms.\n                        </p>\n                      </div>\n                    </div>\n                    <button \n                      onClick={() => {\n                        setShowSeoExplain(true);\n                        window.scrollTo({ top: 0, behavior: \"smooth\" });\n                      }}\n                      className=\"block w-full py-2 bg-stone-200 text-stone-900 hover:bg-stone-300 font-bold text-center tracking-wider rounded uppercase text-[10px] active:scale-95 transition-all cursor-pointer border border-stone-300/40\"\n                    >\n                      RUN DIAGNOSTIC\n                    </button>\n                  </div>\n                </div>\n              </div>"
      }
      num_matches: 1

s://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(typeof window !== \'undefined\' ? window.location.href : \'\')}`}\n                          target=\"_blank\"\n                          rel=\"noopener noreferrer\"\n                          className=\"p-1.5 px-2.5 border border-stone-200 hover:border-stone-900 hover:bg-stone-50 rounded text-stone-700 text-[10px] uppercase font-bold tracking-wider transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                          title=\"Share on Facebook\"\n                        >\n                          <Facebook size={10} className=\"text-stone-500 hover:text-stone-900\" />\n                          <span>FB</span>\n                        </a>\n\n                        {/* LinkedIn */}\n                        <a\n                          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(typeof window !== \'undefined\' ? window.location.href : \'\')}`}\n                          target=\"_blank\"\n                          rel=\"noopener noreferrer\"\n                          className=\"p-1.5 px-2.5 border border-stone-200 hover:border-stone-900 hover:bg-stone-50 rounded text-stone-700 text-[10px] uppercase font-bold tracking-wider transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                          title=\"Share on LinkedIn\"\n                        >\n                          <Linkedin size={10} className=\"text-stone-500 hover:text-stone-900\" />\n                          <span>LN</span>\n                        </a>\n\n                        {/* Copy Link */}\n                        <button\n                          onClick={() => {\n                            if (typeof window !== \'undefined\') {\n                              navigator.clipboard.writeText(window.location.href);\n                              setShareCopied(true);\n                              setTimeout(() => setShareCopied(false), 2000);\n     
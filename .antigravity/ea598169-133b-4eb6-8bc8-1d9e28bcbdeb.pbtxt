      replacement_content: "          <h1 \n            id=\"blog-title\" \n            onClick={() => { setSelectedPostId(null); setActivePost(null); setSearchQuery(\"\"); setCurrentView(\"blog\"); }}\n            className=\"font-display font-black text-3xl md:text-5xl text-stone-900 tracking-tight cursor-pointer hover:opacity-90 active:scale-[0.99] transition-all my-2 text-center relative\"\n          >\n            ZERO NEWS\n            <span className=\"absolute -bottom-1 left-1.2 right-1.2 h-[2px] bg-stone-900\"></span>\n          </h1>\n          <div className=\"text-xs font-mono text-stone-400 mt-2 flex justify-between w-full border-t border-stone-200/50 pt-2.5 px-1 max-w-[280px]\">\n            <span>ISSUE NO. 104-Y</span>\n            <span>{getFormattedDate()}</span>\n          </div>\n \n          {/* Real-time Global Search bar */}\n          <div className=\"w-full mt-4 px-1 relative group max-w-[280px]\">\n            <div className=\"absolute inset-y-0 left-3 flex items-center pointer-events-none text-stone-400 group-focus-within:text-stone-900 transition-colors\">\n              <Search size={13} />\n            </div>\n            <input\n              type=\"text\"\n              id=\"global-search-input\"\n              value={searchQuery}\n              onChange={(e) => {\n                setSearchQuery(e.target.value);\n                setCurrentView(\"blog\");\n                if (selectedPostId) {\n                  setSelectedPostId(null);\n                  setActivePost(null);\n                }\n              }}"
    }
    instruction: "Reset currentView to \'blog\' on header title click or searches"
  }
}

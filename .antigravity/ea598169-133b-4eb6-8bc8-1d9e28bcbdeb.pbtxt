          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const excerptMatch = post.excerpt.toLowerCase().includes(query);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const contentMatch = (post.content || \"\").toLowerCase().includes(query);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return categoryMatch && (titleMatch || excerptMatch || contentMatch);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }

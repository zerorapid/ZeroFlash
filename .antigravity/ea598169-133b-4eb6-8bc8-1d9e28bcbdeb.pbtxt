        lines {
          text: "excerpt: In the past, websites became too complex and heavy. Today, programmers are going back to simpler, lightweight designs for a smoother, faster web."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "readTime: 4 min read"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED

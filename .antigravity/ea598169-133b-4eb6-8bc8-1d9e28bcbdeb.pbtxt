      replacement_content: "      {/* Editorial Header Bar with sharp tech borders */}\n      <header id=\"editorial-header\" className=\"border-b border-stone-200 bg-stone-50 py-6 px-4 md:px-0\">\n        <div className=\"max-w-xl mx-auto flex flex-col items-center\">\n          <div className=\"text-[10px] font-mono uppercase tracking-[0.2em] text-stone-500 mb-1 flex items-center gap-1.5\">\n            <span className=\"w-1.5 h-1.5 rounded bg-orange-500 animate-pulse\"></span>\n            made \342\235\244\357\270\217 with by zerorapid\n          </div>\n          <h1 \n            id=\"blog-title\" \n            onClick={() => { setSelectedPostId(null); setActivePost(null); setSearchQuery(\"\"); }}\n            className=\"font-display font-black text-3xl md:text-5xl text-stone-900 tracking-tight cursor-pointer hover:opacity-90 active:scale-[0.99] transition-all my-2 text-center relative\"\n          >\n            THE CHRONICLE\n            <span className=\"absolute -bottom-1 left-1.2 right-1.2 h-[2px] bg-stone-900\"></span>\n          </h1>\n          <div className=\"text-xs font-mono text-stone-400 mt-2 flex justify-between w-full border-t border-stone-200/50 pt-2.5 px-1 max-w-[280px]\">\n            <span>ISSUE NO. 104-Y</span>\n            <span>{getFormattedDate()}</span>\n          </div>\n\n          {/* Real-time Global Search bar */}\n          <div className=\"w-full mt-4 px-1 relative group max-w-[280px]\">\n            <div className=\"absolute inset-y-0 left-3 flex items-center pointer-events-none text-stone-400 group-focus-within:text-stone-900 transition-colors\">\n              <Search size={13} />\n            </div>\n            <input\n              type=\"text\"\n              id=\"global-search-input\"\n              value={searchQuery}\n              onChange={(e) => {\n                setSearchQuery(e.target.value);\n                if (selectedPostId) {\n                  setSelectedPostId(null);\n                  setActivePost(null);\n                }\n              }}\n              placeholder=\"Search titles, content...\"\n              className=\"w-full text-xs font-mono pl-8 pr-12 py-1.5 bg-stone-100/80 border border-stone-200/95 rounded focus:bg-white focus:border-stone-900 focus:outline-none transition-all placeholder:text-stone-400\"\n            />\n            {searchQuery && (\n              <button\n                id=\"clear-search-btn\"\n                onClick={() => setSearchQuery(\"\")}\n                className=\"absolute inset-y-0 right-3 flex items-center text-stone-400 hover:text-stone-950 transition-colors text-[9px] font-mono uppercase font-bold tracking-wider cursor-pointer\"\n              >\n                Clear\n              </button>\n            )}\n          </div>\n        </div>\n      </header>"

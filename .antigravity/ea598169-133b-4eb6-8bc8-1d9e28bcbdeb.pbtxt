n overhead.\n            </p>\n            <a \n              href=\"https://ai.studio/build\" \n              target=\"_blank\" \n              rel=\"noopener noreferrer\"\n              className=\"block w-full py-2 bg-stone-950 hover:bg-stone-850 text-white font-bold text-center tracking-wider rounded uppercase text-[10px] active:scale-95 transition-all\"\n            >\n              LAUNCH INSTANCE\n            </a>\n          </div>"
        replacement_content: "        {/* Left Ad Banner - Fixed size to prevent Layout Shift (CLS) */}\n        <aside id=\"banner-left\" className=\"hidden xl:flex flex-col gap-6 py-8 h-fit sticky top-6\">\n          <div className=\"border border-stone-200/90 bg-stone-50 p-2.5 rounded-md flex flex-col justify-between font-mono text-[11px] relative shadow-sm w-full min-h-[480px]\">\n            <div className=\"absolute top-3 left-3 bg-stone-100 border border-stone-200/80 text-stone-500 font-bold text-[8px] px-1.5 py-0.5 uppercase tracking-widest rounded\">\n              ADVERT [ 160 \303\227 600 ]\n            </div>\n            {/* Pure image-based advertisement canvas placeholder (ready for custom images or video assets directly, no buttons or paragraphs) */}\n            <div className=\"w-full grow aspect-[160/600] mt-7 bg-stone-100 hover:bg-stone-200/50 rounded border border-stone-200/70 border-dashed flex flex-col justify-center items-center text-stone-400 transition-colors relative overflow-hidden text-center\">\n              <div className=\"absolute top-1 left-1 w-2.5 h-2.5 border-t border-l border-stone-300\"></div>\n              <div className=\"absolute top-1 right-1 w-2.5 h-2.5 border-t border-r border-stone-300\"></div>\n              <div className=\"absolute bottom-1 left-1 w-2.5 h-2.5 border-b border-l border-stone-300\"></div>\n              <div className=\"absolute bottom-1 right-1 w-2.5 h-2.5 border-b border-r border-stone-300\"></div>\n              <Search size={18} className=\"text-stone-300 stroke-[1.2] mb-1.5 mx-auto\" />\n              <span className=\"text-[9px] text-stone-400 select-none\">[ AD IMAGE PLACEHOLDER ]</span>\n              <span className=\"text-[7.5px] text-stone-300 select-none mt-0.5\">TAP TO INSERT</span>\n            </div>\n          </div>"

      target_content: "  // Get comments for an article\n  app.get(\"/api/posts/:id/comments\", (req, res) => {\n    const { id } = req.params;\n    const comments = commentsStore[id] || [];\n    res.json(comments);\n  });\n\n  // Post a comment to an article\n  app.post(\"/api/posts/:id/comments\", (req, res) => {\n    const { id } = req.params;\n    const { author, content } = req.body;\n\n    if (!author || !content) {\n      res.status(400).json({ error: \"Author and content are required\" });\n      return;\n    }\n\n    const newComment: Comment = {\n      id: \"c_\" + Date.now() + \"_\" + Math.random().toString(36).substr(2, 4),\n      author: author.trim(),\n      content: content.trim(),\n      timestamp: new Date().toISOString()\n    };\n\n    if (!commentsStore[id]) {\n      commentsStore[id] = [];\n    }\n\n    commentsStore[id].unshift(newComment);\n    res.status(201).json(newComment);\n  });"
      replacement_content: "  // Get comments for an article (Approved only)\n  app.get(\"/api/posts/:id/comments\", (req, res) => {\n    const { id } = req.params;\n    const comments = commentsStore[id] || [];\n    const approvedComments = comments.filter((c) => c.approved === true);\n    res.json(approvedComments);\n  });\n\n  // Post a comment to an article (Pending moderation with simulated email notification)\n  app.post(\"/api/posts/:id/comments\", (req, res) => {\n    const { id } = req.params;\n    const { author, content } = req.body;\n\n    if (!author || !content) {\n      res.status(400).json({ error: \"Author and content are required\" });\n      return;\n    }\n\n    const newComment: Comment = {\n      id: \"c_\" + Date.now() + \"_\" + Math.random().toString(36).substr(2, 4),\n      postId: id,\n      author: author.trim(),\n      content: content.trim(),\n      timestamp: new Date().toISOString(),\n      approved: false\n    };\n\n    if (!commentsStore[id]) {\n      commentsStore[id] = [];\n    }\n\n    commentsStore[id].unshift(newComment);\n\n    // Save mock moderator notification email log\n    const emailNotification = {\n      id: \"email_\" + Date.now() + \"_\" + Math.random().toString(36).substr(2, 4),\n      to: \"moderator@zeronews.com\",\n      subject: `[Review Needed] Comment pending approval on: \"${id}\"`,\n      body: `Hello Admin,\\n\\nA new comment has been posted by \"${newComment.author}\" and is currently held for moderation.\\n\\nComment Body:\\n\"${newComment.content}\"\\n\\nVerify and approve this comment in your administrator panel.`,\n      timestamp: new Date().toISOString()\n    };\n    moderatorEmails.unshift(emailNotification);\n    console.log(`[SMTP Mail Notification]:`, emailNotification);\n\n    res.status(201).json({ ...newComment, pendingModeration: true });\n  });"
    }

        replacement_content: "                     <div className=\"mt-4 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-stone-100\">\n                      <div className=\"flex items-center gap-2 text-stone-600 text-xs font-mono\">\n                        <div className=\"w-5 h-5 rounded-full bg-stone-200 flex items-center justify-center font-bold text-stone-700 text-[10px]\">\n                          {activePost.author[0]}\n                        </div>\n                        <span>Written by <strong className=\"text-stone-900 font-semibold\">{activePost.author}</strong></span>\n                      </div>\n\n                      <div className=\"flex flex-wrap items-center gap-1.5 text-xs font-mono\">\n                        <span className=\"text-[10px] text-stone-400 font-mono select-none mr-1 flex items-center gap-1\">\n                          <Share2 size={12} />\n                          SHARE STORY:\n                        </span>\n                        \n                        {/* Twitter / X */}\n                        <a\n                          href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(typeof window !== \'undefined\' ? window.location.href : \'\')}&text=${encodeURIComponent(activePost.title)}`}\n                          target=\"_blank\"\n                          rel=\"noopener noreferrer\"\n                          className=\"p-1.5 px-2.5 border border-stone-200 hover:border-stone-900 hover:bg-stone-50 rounded text-stone-700 text-[10px] uppercase font-bold tracking-wider transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                          title=\"Share on X\"\n                        >\n                          <Twitter size={10} className=\"text-stone-500 hover:text-stone-900\" />\n                          <span>X</span>\n                        </a>\n\n                        {/* Facebook */}\n                        <a\n                          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(typeof window !== \'undefined\' ? window.location.href : \'\')}`}\n                          target=\"_blank\"\n                          rel=\"noopener noreferrer\"\n                          className=\"p-1.5 px-2.5 border border-stone-200 hover:border-stone-900 hover:bg-stone-50 rounded text-stone-700 text-[10px] uppercase font-bold tracking-wider transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                          title=\"Share on Facebook\"\n                        >\n                          <Facebook size={10} className=\"text-stone-500 hover:text-stone-900\" />\n                          <span>FB</span>\n                        </a>\n\n                        {/* LinkedIn */}\n                        <a\n                          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(typeof window !== \'undefined\' ? window.location.href : \'\')}`}\n                          target=\"_blank\"\n                          rel=\"noopener noreferrer\"\n                          className=\"p-1.5 px-2.5 border border-stone-200 hover:border-stone-900 hover:bg-stone-50 rounded text-stone-700 text-[10px] uppercase font-bold tracking-wider transition-colors inline-flex items-center gap-1 cursor-pointer\"\n                          title=\"Share on LinkedIn\"\n                        >\n                          <Linkedin size={10} className=\"text-stone-500 hover:text-stone-900\" />\n                          <span>LN</span>\n                        </a>\n\n                        {/* Copy Link */}\n                        <button\n                          onClick={() => {\n                            if (typeof window !== \'undefined\') {\n                              navigator.clipboard.writeText(window.location.href);\n                              setShareCopied(true);\n                              setTimeout(() => setShareCopied(false), 2000);\n                            }\n                          }}\n                          className=\"p-1.5 px-2.5 cursor-pointer border border-stone-200 hover:border-stone-900 hover:bg-stone-50 rounded text-stone-700 text-[10px] uppercase font-bold tracking-wider transition-colors inline-flex items-center gap-1\"\n                          title=\"Copy Link URL\"\n                        >\n                          <Link size={10} className=\"text-stone-500 hover:text-stone-900\" />\n                          <span>{shareCopied ? \"COPIED\" : \"LINK\"}</span>\n                        </button>\n                      </div>\n                    </div>"

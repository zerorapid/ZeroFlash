      replacement_content: "  // Submit comment\n  const handleCommentSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedPostId || !commentName.trim() || !commentBody.trim()) return;\n\n    try {\n      setCommentingStatus(\"submitting\");\n      const res = await fetch(`/api/posts/${selectedPostId}/comments`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          author: commentName,\n          content: commentBody\n        })\n      });\n\n      if (res.ok) {\n        // Since comment is initially pending (approved: false), \n        // we display the success pending status message and do not inject in public active comments.\n        setCommentName(\"\");\n        setCommentBody(\"\");\n        setCommentingStatus(\"success\");\n        setTimeout(() => setCommentingStatus(\"idle\"), 6000);\n      } else {\n        setCommentingStatus(\"error\");\n      }\n    } catch (err) {\n      console.error(err);\n      setCommentingStatus(\"error\");\n    }\n  };"

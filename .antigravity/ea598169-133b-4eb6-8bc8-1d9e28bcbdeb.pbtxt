      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-display: \"Space Grotesk\", \"Inter\", sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n}\n\n/* Base styles tailored for reading on mobile screens */\nbody {\n  background-color: #fbfbf9; /* Cozy, eye-safe, editorial off-white background */\n  color: #1f2022;            /* Luxurious charcoal grey for highest legibility and contrast */\n  font-feature-settings: \"cv02\", \"cv03\", \"cv04\", \"cv11\";\n  text-rendering: optimizeLegibility;\n}\n\n/* Custom Markdown Content styling for blog content */\n.markdown-body {\n  font-family: var(--font-sans);\n  line-height: 1.75;\n  color: #2e3033;\n}\n\n.markdown-body h1,\n.markdown-body h2,\n.markdown-body h3,\n.markdown-body h4 {\n  font-family: var(--font-display);\n  color: #111111;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  margin-top: 1.8em;\n  margin-bottom: 0.6em;\n}\n\n.markdown-body h1 {\n  font-size: 1.85rem;\n}\n\n.markdown-body h2 {\n  font-size: 1.5rem;\n  border-bottom: 1px solid #e5e5e0;\n  padding-bottom: 0.3em;\n}\n\n.markdown-body h3 {\n  font-size: 1.25rem;\n}\n\n.markdown-body p {\n  margin-top: 0;\n  margin-bottom: 1.25em;\n  font-size: 1.05rem;\n  font-weight: 400;\n  letter-spacing: -0.01em;\n}\n\n.markdown-body p strong {\n  color: #111111;\n  font-weight: 600;\n}\n\n.markdown-body blockquote {\n  margin: 1.5em 0;\n  padding-left: 1.25em;\n  border-left: 3px solid #111111;\n  color: #555552;\n  font-style: italic;\n  font-size: 1.1rem;\n}\n\n.markdown-body ul,\n.markdown-body ol {\n  margin-top: 0;\n  margin-bottom: 1.25em;\n  padding-left: 1.5em;\n}\n\n.markdown-body ul {\n  list-style-type: square;\n}\n\n.markdown-body ol {\n  list-style-type: decimal;\n}\n\n.markdown-body li {\n  margin-top: 0.25em;\n  margin-bottom: 0.25em;\n  padding-left: 0.25em;\n}\n\n.markdown-body pre {\n  margin: 1.5em 0;\n  padding: 1rem;\n  background-color: #f4f3ee;\n  border: 1px solid #e5e5e0;\n  border-radius: 4px;\n  overflow-x: auto;\n  font-family: var(--font-mono);\n  font-size: 0.875rem;\n}\n\n.markdown-body code {\n  font-family: var(--font-mono);\n  font-size: 0.85em;\n  background-color: #f4f3ee;\n  padding: 0.2em 0.4em;\n  border-radius: 3px;\n  color: #c2410c;\n}\n\n.markdown-body pre code {\n  background-color: transparent;\n  padding: 0;\n  color: inherit;\n  font-size: inherit;\n}\n\n.markdown-body table {\n  width: 100%;\n  margin-top: 1.5em;\n  margin-bottom: 1.5em;\n  border-collapse: collapse;\n  font-size: 0.95rem;\n}\n\n.markdown-body th {\n  background-color: #f4f3ee;\n  font-weight: 600;\n  text-align: left;\n  border-bottom: 2px solid #e5e5e0;\n  padding: 0.5rem;\n}\n\n.markdown-body td {\n  border-bottom: 1px solid #e5e5e0;\n  padding: 0.5rem;\n}\n\n/* Hide scrollbar utility */\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n"
    }

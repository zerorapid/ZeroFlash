      replacement_content: "  const startEditPost = (post: Post) => {\n    setEditingPost(post);\n    setFormId(post.id);\n    setFormTitle(post.title);\n    setFormCategory(post.category);\n    setFormTags(post.tags ? post.tags.join(\", \") : \"\");\n    setFormAuthor(post.author);\n    setFormExcerpt(post.excerpt);\n    setFormReadTime(post.readTime);\n    setFormContent(post.content || \"\");\n    setAdminSubView(\"edit\");\n  };\n\n  const handleTagToggle = (tag: string) => {\n    setSelectedTags((prev) =>\n      prev.includes(tag) ? prev.filter((t) => t !== tag) : [...prev, tag]\n    );\n  };\n\n  const fetchAllComments = async () => {\n    try {\n      const res = await fetch(\"/api/admin/comments\");\n      if (res.ok) {\n        const data = await res.json();\n        setAllComments(data);\n      }\n    } catch (err) {\n      console.error(\"Failed to load moderator comments list.\", err);\n    }\n  };\n\n  const fetchUploadedImages = async () => {\n    try {\n      const res = await fetch(\"/api/admin/images\");\n      if (res.ok) {\n        const data = await res.json();\n        setUploadedImages(data);\n      }\n    } catch (err) {\n      console.error(\"Failed to fetch custom visuals library.\", err);\n    }\n  };\n\n  const fetchEmailLogs = async () => {\n    try {\n      const res = await fetch(\"/api/admin/emails\");\n      if (res.ok) {\n        const data = await res.json();\n        setAllEmailLogs(data);\n      }\n    } catch (err) {\n      console.error(\"Failed to load email logs.\", err);\n    }\n  };\n\n  const handleApproveComment = async (commentId: string) => {\n    try {\n      const res = await fetch(`/api/admin/comments/${commentId}/approve`, {\n        method: \"PUT\"\n      });\n      if (res.ok) {\n        setAllComments(prev => prev.map(c => c.id === commentId ? { ...c, approved: true } : c));\n        if (selectedPostId) {\n          const updatedComments = await fetch(`/api/posts/${selectedPostId}/comments`);\n          if (updatedComments.ok) {\n            setComments(await updatedComments.json());\n          }\n        }\n      }\n    } catch (err) {\n      console.error(\"Failed to approve comment:\", err);\n    }\n  };\n\n  const handleRejectComment = async (commentId: string) => {\n    if (!window.confirm(\"Are you sure you want to reject and remove this comment?\")) return;\n    try {\n      const res = await fetch(`/api/admin/comments/${commentId}`, {\n        method: \"DELETE\"\n      });\n      if (res.ok) {\n        setAllComments(prev => prev.filter(c => c.id !== commentId));\n        if (selectedPostId) {\n          const updatedComments = await fetch(`/api/posts/${selectedPostId}/comments`);\n          if (updatedComments.ok) {\n            setComments(await updatedComments.json());\n          }\n        }\n      }\n    } catch (err) {\n      console.error(\"Failed to reject comment:\", err);\n    }\n  };\n\n  const handleDeleteImage = async (filename: string) => {\n    if (!window.confirm(`Are you sure you want to delete \"${filename}\"?`)) return;\n    try {\n      const res = await fetch(`/api/admin/images/${filename}`, {\n        method: \"DELETE\"\n      });\n      if (res.ok) {\n        setUploadedImages(prev => prev.filter(img => img.name !== filename));\n      }\n    } catch (err) {\n      console.error(\"Failed to delete image file:\", err);\n    }\n  };"
    }
